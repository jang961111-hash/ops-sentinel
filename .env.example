# US-016: docker compose up 전에 이 파일을 .env로 복사하고 값을 채워라.
# 예: cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않는다 — 실제 값은 여기(.env.example)에 넣지 말 것.

# PostgreSQL (docker-compose의 postgres 서비스 + app의 docker 프로필이 공유)
DB_NAME=opssentinel
DB_USER=opssentinel
DB_PASSWORD=

# OpenAI 연동(US-013) — 비워두면 AiSummaryService가 자동으로 폴백 문장을 사용한다
OPENAI_API_KEY=

# JWT 최소 구현(US-014) — 비워두면 기동 시 랜덤 시크릿이 생성된다(재기동 시 토큰 무효화됨)
JWT_SECRET=

# 관리자 로그인 비밀번호(US-014) — 데모 기본값은 admin1234, 운영/공유 환경에서는 반드시 변경
ADMIN_PASSWORD=
