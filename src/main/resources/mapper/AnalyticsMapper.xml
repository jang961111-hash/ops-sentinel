<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opssentinel.analytics.AnalyticsMapper">

    <!--
        record 생성자를 명시적으로 매핑한다(<constructor>). resultType 자동매핑(map-underscore-to-camel-case)에
        기대지 않고 컬럼-생성자 인자를 직접 지정해, 컴파일러 -parameters 옵션 여부와 무관하게 안전하게 동작하도록 한다.
    -->
    <resultMap id="incidentSummaryResultMap" type="com.opssentinel.analytics.web.dto.IncidentSummaryByResourceResponse">
        <constructor>
            <idArg column="resource_id" javaType="java.lang.Long"/>
            <arg column="resource_name" javaType="java.lang.String"/>
            <arg column="incident_count" javaType="_long"/>
            <arg column="low_count" javaType="_long"/>
            <arg column="medium_count" javaType="_long"/>
            <arg column="high_count" javaType="_long"/>
            <arg column="critical_count" javaType="_long"/>
            <arg column="avg_resolution_minutes" javaType="java.lang.Double"/>
        </constructor>
    </resultMap>

    <!--
        리소스별/기간별 사건 건수, 심각도 분포, 평균 해결시간(MTTR 유사 지표, 분 단위)을 집계한다.
        평균 해결시간은 resolved_at이 있는(=RESOLVED로 전이된) 사건만 대상으로 하며, AVG는 NULL을
        자동으로 제외하므로 CASE로 미해결 건을 NULL 처리하는 것만으로 충분하다.
    -->
    <select id="selectIncidentSummary" resultMap="incidentSummaryResultMap">
        SELECT
            r.id AS resource_id,
            r.name AS resource_name,
            COUNT(*) AS incident_count,
            SUM(CASE WHEN i.severity = 'LOW' THEN 1 ELSE 0 END) AS low_count,
            SUM(CASE WHEN i.severity = 'MEDIUM' THEN 1 ELSE 0 END) AS medium_count,
            SUM(CASE WHEN i.severity = 'HIGH' THEN 1 ELSE 0 END) AS high_count,
            SUM(CASE WHEN i.severity = 'CRITICAL' THEN 1 ELSE 0 END) AS critical_count,
            AVG(CASE WHEN i.resolved_at IS NOT NULL THEN DATEDIFF('MINUTE', i.detected_at, i.resolved_at) END) AS avg_resolution_minutes
        FROM incidents i
        JOIN resources r ON r.id = i.resource_id
        <where>
            <if test="from != null">AND i.detected_at &gt;= #{from}</if>
            <if test="to != null">AND i.detected_at &lt;= #{to}</if>
        </where>
        GROUP BY r.id, r.name
        ORDER BY incident_count DESC
    </select>

    <resultMap id="resourceHealthRankResultMap" type="com.opssentinel.analytics.web.dto.ResourceHealthRankResponse">
        <constructor>
            <idArg column="resource_id" javaType="java.lang.Long"/>
            <arg column="resource_name" javaType="java.lang.String"/>
            <arg column="resource_type" javaType="com.opssentinel.resource.entity.ResourceType"/>
            <arg column="incident_count" javaType="_long"/>
        </constructor>
    </resultMap>

    <!--
        사건 발생 빈도 기준 리소스 위험도 랭킹. LEFT JOIN으로 사건이 한 건도 없는 리소스도
        incident_count=0으로 포함시켜 전체 리소스 대비 위험도를 한눈에 보게 한다.
    -->
    <select id="selectResourceHealthRank" resultMap="resourceHealthRankResultMap">
        SELECT
            r.id AS resource_id,
            r.name AS resource_name,
            r.type AS resource_type,
            COUNT(i.id) AS incident_count
        FROM resources r
        LEFT JOIN incidents i ON i.resource_id = r.id
        GROUP BY r.id, r.name, r.type
        ORDER BY incident_count DESC, r.id ASC
    </select>

</mapper>
